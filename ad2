class DonutChartPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final radius = size.width / 2.2;
    final arcPaints = [
      Paint()..color = const Color(0xFF1DBA94),
      Paint()..color = const Color(0xFFF2B942),
      Paint()..color = const Color(0xFF7FA3FF),
      Paint()..color = const Color(0xFFEA6A5C),
    ];
    final gaps = [0.20, 0.18, 0.12, 0.10];
    double start = -math.pi / 2;
    for (int i = 0; i < arcPaints.length; i++) {
      final sweep = 2 * math.pi * gaps[i];
      canvas.drawArc(
        Rect.fromCircle(center: center, radius: radius),
        start,
        sweep,
        false,
        arcPaints[i],
      );
      start += sweep;
    }
    final inner = Paint()..color = Colors.white;
    canvas.drawCircle(center, radius * 0.62, inner);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

