rules_version = '2';

// Masroufi: every document lives under users/{uid}, and only that signed-in
// user may read or write it. Paste into Firebase console → Firestore →
// Rules, or deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /expenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.title is string
          && request.resource.data.expenseDate is timestamp;
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(uid);
      }

      match /savingsGoals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
